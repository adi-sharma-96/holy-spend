FROM debian:bookworm-slim AS downloader

ARG TUNNEL_CLIENT_VERSION=v0.0.10
ARG TARGETARCH=amd64

RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends ca-certificates curl unzip; \
    case "${TARGETARCH}" in \
        amd64) checksum="b9e0388a343f2d7adeff3992f411a0bd3d916a64bc56534aac5fd15ac1b20cd5" ;; \
        arm64) checksum="b842a9b2352eebd80514cf01a1fbb1c0d400a7d24a4015e85a7ea5f1aeaa5b30" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    archive="tunnel-client-${TUNNEL_CLIENT_VERSION}-linux-${TARGETARCH}.zip"; \
    curl --fail --show-error --location \
        "https://persistent.oaistatic.com/tunnel-client/${TUNNEL_CLIENT_VERSION}/${archive}" \
        --output "/tmp/${archive}"; \
    printf '%s  %s\n' "${checksum}" "/tmp/${archive}" | sha256sum --check --strict; \
    unzip "/tmp/${archive}" -d /tmp/tunnel-client-release; \
    install -m 0755 /tmp/tunnel-client-release/tunnel-client /usr/local/bin/tunnel-client

FROM debian:bookworm-slim

RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /var/lib/tunnel-client; \
    chown 65532:65532 /var/lib/tunnel-client

COPY --from=downloader /usr/local/bin/tunnel-client /usr/local/bin/tunnel-client
COPY deploy/tunnel-entrypoint.sh /usr/local/bin/tunnel-entrypoint

RUN chmod 0755 /usr/local/bin/tunnel-entrypoint

ENV HOME=/var/lib/tunnel-client

USER 65532:65532

ENTRYPOINT ["tunnel-entrypoint"]
