APP_NAME="Holy Spend"
ENVIRONMENT="local"
DATABASE_URL="postgresql://expense_app:change-me@localhost:54322/postgres"
PAT_PEPPER="replace-with-a-long-random-secret"
# Privileged direct/session-pooler URL used only by scripts/manage_pat.py.
# Never use the expense_app runtime role here and never expose this value.
PAT_ADMIN_DATABASE_URL="postgresql://postgres.your-project-ref:password@host:5432/postgres?sslmode=require"
RECONCILIATION_ACCEPTED_CENTS=2
RECONCILIATION_WARNING_CENTS=100
SUPPORTED_CURRENCIES='["CAD","USD"]'

# IANA timezone the single owner lives in. Drives "today" for the dashboard
# window, the spending calendar, and future-date validation, since the server
# process's own system clock is UTC and has no idea what day it is for you.
LOCAL_TIMEZONE="America/New_York"

# The mounted MCP server is intentionally private and resolves every tool call
# to this server-side owner. The model must never be allowed to choose a user ID.
# Keep disabled on any public REST deployment. Enable only behind the secure
# tunnel or another private network boundary.
MCP_ENABLED=0
AUTH_MODE="single_user"
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"
MCP_ALLOWED_HOSTS="127.0.0.1:*,localhost:*"
MCP_ALLOWED_ORIGINS=""

# Comma-separated origins used by the MCP widget CSP. SUPABASE_URL is included
# automatically for direct signed uploads. Keep these lists narrow.
MCP_WIDGET_CONNECT_DOMAINS=""
MCP_WIDGET_RESOURCE_DOMAINS=""

# Required by receipt-file endpoints. Use the project URL and a backend-only
# modern secret key (preferred) or legacy service-role key from Supabase.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="replace-with-backend-only-secret-key"

# Private Supabase Storage bucket and receipt-file limits.
STORAGE_BUCKET="receipt-originals"
STORAGE_SIGNED_URL_TTL_SECONDS=300
MAX_RECEIPT_FILE_BYTES=10485760
RECEIPT_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
RECEIPT_DOWNLOAD_READ_TIMEOUT_SECONDS=20
RECEIPT_DOWNLOAD_WRITE_TIMEOUT_SECONDS=5
RECEIPT_DOWNLOAD_POOL_TIMEOUT_SECONDS=5
RECEIPT_DOWNLOAD_MAX_REDIRECTS=3
RECEIPT_PREPARATION_TTL_SECONDS=600
# Optional. Defaults to the operating system temporary directory.
RECEIPT_PREPARATION_DIR=

# Optional destructive hosted Storage adapter test. Leave disabled normally.
RUN_LIVE_STORAGE_TESTS=0

# Read server-side only, by the nutrition_lookup_usda(_detail) MCP tools -
# never sent to or through a connecting client. DEMO_KEY works but is
# rate-limited to ~30 requests/hour; a free personal key from
# https://fdc.nal.usda.gov/api-key-signup.html raises that substantially.
USDA_FDC_API_KEY="DEMO_KEY"
NUTRITION_LOOKUP_TIMEOUT_SECONDS=15
